Package: dilp
Title: Reconstruct Paleoclimate and Paleoecology with Leaf Physiognomy
Version: 1.4.0.9001
Authors@R: c(
    person(given = "Matthew J.", family = "Butrim", email = "mbutrim@uwyo.edu", role = c("aut", "cre", "cph")),
